# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.
# cp .env.example .env

# ---- Genel ----
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
LOG_LEVEL=INFO

# ---- AI / LLM Sağlayıcısı ----
# Seçenekler: gemini | openai | anthropic | ollama
# Varsayılan 'gemini' - ücretsiz katmanı en cömert olan sağlayıcı.
AI_PROVIDER=gemini

# Google AI Studio'dan ücretsiz alınabilir: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama tamamen yerel çalışır, API key gerekmez.
# Kurulum: https://ollama.com  ->  `ollama serve` &  `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1500
