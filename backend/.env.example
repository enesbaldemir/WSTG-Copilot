# Bu dosyayi .env olarak kopyalayin ve gerektigi gibi doldurun.
# hicbiri zorunlu degildir; bos birakilirsa makul varsayilanlar kullanilir.

# DATABASE_URL=sqlite:///database/wstg.db

# Bos birakilirsa ilk acilista rastgele uretilip backend/instance/secret_key
# dosyasina kaydedilir. Elle verecekseniz uzun, rastgele bir deger kullanin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Sadece bu adreslerdeki frontend API'yi cagirabilir; baska bir siteden gelen
# POST/PUT/PATCH/DELETE istekleri reddedilir.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Kabul edilen Host basliklari (DNS rebinding korumasi).
# ALLOWED_HOSTS=localhost,127.0.0.1,::1

# python app.py'nin dinledigi adres. Varsayilan yalnizca bu makine (127.0.0.1).
# Ag'a acmak icin: WSTG_HOST=0.0.0.0 ve ALLOWED_HOSTS'a bu makinenin adini/IP'sini
# ekleyin. Trafik sifresizdir (HTTP); parola ve oturum cerezi agda acik gider.
# Ilk parola yalnizca bu makineden (veya `python app.py set-password`) belirlenebilir.
# WSTG_HOST=127.0.0.1
# WSTG_PORT=5000

# --- Kimlik dogrulama (tek kullanici; bkz. README > Kimlik Dogrulama) ---
# Parola .env'de DEGIL, veritabaninda tuzlanmis hash olarak saklanir. Ilk
# acilista arayuzden ya da terminalden belirlenir/sifirlanir:
#   python app.py set-password
# Kimlik dogrulamayi kapatan bir ayar yoktur.
#
# Girisin gecerlilik suresi (saat). Giristen itibaren sayilir, kullanim uzatmaz.
# WSTG_SESSION_HOURS=12
# 1 = oturum cerezi Secure. Yalnizca API HTTPS arkasindaysa acin; duz HTTP'de
# tarayici cerezi gondermez ve giris yapilamaz.
# SESSION_COOKIE_SECURE=0

# 1 = Werkzeug debugger acik. WSTG_HOST loopback degilse uygulama baslamaz.
# FLASK_DEBUG=0
# LOG_LEVEL=INFO

# Evidence Intelligence (opsiyonel):
# Ayarlanirsa, Evidence sekmesine yuklenen ekran goruntuleri Claude'un
# vision API'sine gonderilip WSTG testleriyle otomatik eslestirilir
# (oneri olarak - siz Accept/Reject ile onaylarsiniz).
# Bos birakilirsa bu ozellik sessizce devre disi kalir, hicbir sahte/
# uydurma analiz uretilmez.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Cok-saglayicili AI katmani (Report Assistant, duplicate/CWE onerisi, vb.) ---
# Bunlar sadece FALLBACK'tir -- birincil yol artik uygulama icindeki
# "AI Ayarlari" panelidir (bir sagliyici secip key'i orada girebilirsiniz).
# Buradakiler sadece .env/docker/CI gibi UI'siz ortamlar icin gecerlidir.
# AI_PROVIDER=gemini                  # gemini | openai | anthropic | ollama
# AI_REQUEST_TIMEOUT=30
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.7-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra
# ANTHROPIC_MODEL=claude-sonnet-5     # ANTHROPIC_API_KEY yukarida tanimli
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# AI Ayarlari panelinde saklanan API key'lerini sifrelemek icin kullanilir.
# Bos birakilirsa SECRET_KEY'den turetilir (SECRET_KEY degisirse kayitli
# key'ler cozulemez hale gelir, yeniden girilmesi istenir).
# ENCRYPTION_KEY=
